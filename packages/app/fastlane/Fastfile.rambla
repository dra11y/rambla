# Rambla's own fastlane lanes. Upstream's Fastfile imports this file and is
# otherwise untouched, so every lane below is unambiguously this fork's.
#
# Self-contained on purpose: it defines its own constant rather than reusing
# upstream's APP_IDENTIFIER, so a rename upstream cannot break it.

RAMBLA_APP_IDENTIFIER = "sh.rambla"

# Where build_ipa leaves the artifact, relative to packages/app. Fixed so a
# separate upload job can find the .ipa without rebuilding it.
RAMBLA_BUILD_DIR = "build"
RAMBLA_OUTPUT_NAME = "rambla"

platform :ios do
  desc "Create or fetch the App Store distribution certificate and provisioning profile"
  lane :sync_signing do |options|
    # Accepts both a real boolean (internal calls) and the string fastlane
    # produces for `readonly:false` on the command line.
    readonly = options[:readonly].to_s != "false"

    setup_ci if is_ci

    match(
      type: "appstore",
      api_key: rambla_asc_api_key,
      app_identifier: RAMBLA_APP_IDENTIFIER,
      readonly: readonly,
    )
  end

  desc "Build the iOS app and upload it to TestFlight"
  lane :beta do
    ipa = build_ipa
    upload_ipa(ipa: ipa)
  end

  desc "Build a signed App Store .ipa without uploading it"
  lane :build_ipa do
    sync_signing(readonly: true)

    # A lane body runs with the working directory set to the fastlane folder
    # itself; only actions get chdir'd up to the project folder. Plain Ruby here
    # has to anchor its own paths.
    app_dir = File.expand_path("..")
    workspace = Dir.glob(File.join(app_dir, "ios", "*.xcworkspace")).first
    UI.user_error!("No Xcode workspace in #{app_dir}/ios; run `expo prebuild --platform ios` first") if workspace.nil?

    # Expo prebuild names the project, workspace, and scheme after the app.
    scheme = File.basename(workspace, ".xcworkspace")
    profile_name = ENV.fetch(
      "sigh_#{RAMBLA_APP_IDENTIFIER}_appstore_profile-name",
      "match AppStore #{RAMBLA_APP_IDENTIFIER}",
    )

    # Prebuild regenerates the project with automatic signing and no team, which
    # cannot archive on a runner that has no Apple ID session.
    update_code_signing_settings(
      path: "ios/#{scheme}.xcodeproj",
      use_automatic_signing: false,
      team_id: ENV.fetch("APPLE_TEAM_ID"),
      targets: [scheme],
      bundle_identifier: RAMBLA_APP_IDENTIFIER,
      code_sign_identity: "Apple Distribution",
      profile_name: profile_name,
    )

    # gym writes the dSYM zip as <output_name>.app.dSYM.zip beside the .ipa.
    ipa_path = build_app(
      workspace: workspace,
      scheme: scheme,
      configuration: "Release",
      export_method: "app-store",
      include_symbols: true,
      output_directory: File.join(app_dir, RAMBLA_BUILD_DIR),
      output_name: RAMBLA_OUTPUT_NAME,
      export_options: {
        provisioningProfiles: {
          RAMBLA_APP_IDENTIFIER => profile_name,
        },
      },
    )

    UI.success("Built #{ipa_path}")
    ipa_path
  end

  desc "Upload an already-built .ipa to TestFlight"
  lane :upload_ipa do |options|
    # No match, no signing, no build: uploading needs only the API key, so a
    # failed upload retries without paying for the archive again.
    ipa = options[:ipa] || File.expand_path(File.join("..", RAMBLA_BUILD_DIR, "#{RAMBLA_OUTPUT_NAME}.ipa"))
    UI.user_error!("No .ipa at #{ipa}") unless File.exist?(ipa)

    # submit_review polls App Store Connect for processing, so this job does not
    # have to hold a runner open for it.
    upload_to_testflight(
      api_key: rambla_asc_api_key,
      app_identifier: RAMBLA_APP_IDENTIFIER,
      ipa: ipa,
      skip_waiting_for_build_processing: true,
    )
  end

  private_lane :rambla_asc_api_key do
    app_store_connect_api_key(
      key_id: ENV.fetch("ASC_KEY_ID"),
      issuer_id: ENV.fetch("ASC_ISSUER_ID"),
      key_filepath: ENV.fetch("ASC_KEY_P8"),
    )
  end
end
